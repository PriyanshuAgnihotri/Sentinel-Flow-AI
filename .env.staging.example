# Template only: configure these as secret/environment variables in staging.
APP_ENV=staging
APP_NAME=SentinelFlow
API_PREFIX=/api/v1

# Use a managed PostgreSQL service and a managed Redis service for staging.
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB
REDIS_URL=redis://REPLACE_REDIS_HOST:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
FRONTEND_ORIGINS=https://REPLACE_WITH_STAGING_FRONTEND_HOST

SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=3600
MAX_GRAPH_STEPS=8

# Generate separate, cryptographically random secrets of at least 32 characters.
# Store real values in deployment environment variables; never commit real secrets.
APPROVAL_API_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_JWT_ISSUER=sentinelflow-staging
AUTH_JWT_AUDIENCE=sentinelflow-api
