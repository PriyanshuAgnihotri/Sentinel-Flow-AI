APP_ENV=local
APP_NAME=SentinelFlow
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:8501
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=3600
MAX_GRAPH_STEPS=8
APPROVAL_API_TOKEN=replace-with-a-long-random-secret
